{
  "name": "trackie-app",
  "version": "1.0.0",
  "description": "Trackie - native Android/iOS shell (Capacitor) for https://trackie.free.nf",
  "private": true,
  "scripts": {
    "sync": "npx cap sync",
    "sync:android": "npx cap sync android",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "assets": "npx capacitor-assets generate --assetPath resources --iconBackgroundColor #ffffff --splashBackgroundColor #0f172a --splashBackgroundColorDark #0f172a"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
