# Sensitive — contains DB credentials & API keys
config/env.php

# Backup archives — may contain old copies of config/env.php with real secrets
*.rar
*.zip
*.7z

# User uploads (keep the folder, ignore uploaded avatars)
assets/images/profile_*

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
*.swp
.vscode/
.idea/

# Legacy / superseded — kept locally, not tracked in the repo
mobile/ios/
mobile/download/
database/trackie_v1.sql
database/trackie_v1_additions.sql
database/trackie_v2_schema.sql
database/migration_hobbies_update.sql

# Server-side cache of exercise demo GIFs (fetched from ExerciseDB)
assets/cache/exercise-gifs/

# Private user uploads (photos). Served only via api/photo_file.php.
storage/photos/*
!storage/photos/.gitkeep

# Deploy bundles built by scripts/deploy_bundle.php
dist/

# Server-generated secrets (cron token, VAPID keys) — never committed
keys/*
!keys/.htaccess

# Node / Capacitor
node_modules/

# Android build outputs and local machine files (the project itself IS committed)
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/capacitor-cordova-android-plugins/build/
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/app/src/main/assets/capacitor.plugins.json

# Secrets — never commit (CI gets them from GitHub secrets)
*.jks
*.keystore
*.p12
keystore.properties
mobile/android/app/google-services.json
keys/fcm-service-account.json
