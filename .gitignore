# Sensitive — contains DB credentials & API keys
config/env.php

# Backup archives — may contain old copies of config/env.php with real secrets
*.rar
*.zip
*.7z

# User uploads (keep the folder, ignore uploaded avatars)
assets/images/profile_*

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
*.swp
.vscode/
.idea/

# Legacy / superseded — kept locally, not tracked in the repo
mobile/ios/
mobile/download/
database/trackie_v1.sql
database/trackie_v1_additions.sql
database/trackie_v2_schema.sql
database/migration_hobbies_update.sql

# Server-side cache of exercise demo GIFs (fetched from ExerciseDB)
assets/cache/exercise-gifs/

# Private user uploads (photos). Served only via api/photo_file.php.
storage/photos/*
!storage/photos/.gitkeep

# Deploy bundles built by scripts/deploy_bundle.php
dist/

# Server-generated secrets (cron token, VAPID keys) — never committed
keys/*
!keys/.htaccess
