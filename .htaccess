# Trackie v1.0 — Root .htaccess
# NOTE: <Directory> blocks are invalid in .htaccess.
# Sub-directory protection is handled by per-directory .htaccess files.

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Block direct access to sensitive file types
<FilesMatch "\.(sql|md|log|env|lock|gitignore|keystore|jks|properties|ts)$">
    Require all denied
</FilesMatch>

# Archives, backups and dumps. A full-site zip in the web root once contained
# config/env.php — never let one be downloadable, even if uploaded by mistake.
<FilesMatch "\.(zip|tar|gz|tgz|rar|7z|bak|old|orig|swp|dump|iml)$">
    Require all denied
</FilesMatch>

# Package manifests and dotfiles (.env, .htpasswd, .DS_Store, …).
<FilesMatch "^(package(-lock)?\.json|composer\.(json|lock)|\..+)$">
    Require all denied
</FilesMatch>

# VCS / IDE directories — FilesMatch only sees file names, so match the path.
RedirectMatch 404 /\.(git|idea|vscode|svn|hg)(/|$)

# Security headers for STATIC assets only.
# HTML responses get their headers from config/app.php instead — PHP is the
# single authority there, so the two cannot drift and we don't emit each
# header twice. Static files never touch PHP, so they still need these here.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|json)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "same-origin"
    </FilesMatch>
</IfModule>

# The service worker and manifest must always be revalidated — a cached sw.js
# is how installed PWAs get stuck on an old version. (Before the long-cache
# rule below, which would otherwise match .js.)
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.json|offline\.html)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_headers.c>
    <FilesMatch "(?<!^sw)\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
