<?php
/**
 * Trackie — environment configuration TEMPLATE.
 *
 * Copy this file to config/env.php and fill in your own values.
 * config/env.php is gitignored — never commit real credentials.
 */

$__host    = $_SERVER['HTTP_HOST'] ?? '';
$__isLocal = $__host === ''                              // CLI
          || str_contains($__host, 'localhost')
          || str_starts_with($__host, '127.')
          || str_starts_with($__host, '192.168.')
          || str_starts_with($__host, '10.');

if ($__isLocal) {
    // ── Local development ────────────────────────────────────────
    define('DB_HOST', 'localhost');
    define('DB_NAME', 'trackie');
    define('DB_USER', 'root');
    define('DB_PASS', '');
} else {
    // ── Live hosting ──────────────────────────────────────────────
    define('DB_HOST', '');
    define('DB_NAME', '');
    define('DB_USER', '');
    define('DB_PASS', '');
}
unset($__host, $__isLocal);

// ── Timezone ───────────────────────────────────────────────────
if (function_exists('putenv')) putenv('APP_TIMEZONE=UTC');

// ── Optional integrations (leave blank to disable) ──────────────
// Each of these is read via env('KEY') from includes/functions.php.
// See includes/integrations.php for what each one unlocks and where
// to get a key.

define('SPOTIFY_CLIENT_ID',     '');
define('SPOTIFY_CLIENT_SECRET', '');

// Weather runs on Open-Meteo (open-meteo.com) — free, no key needed.

define('GEMINI_API_KEY', '');        // AI Coach  → aistudio.google.com/app/apikey
define('GITHUB_CLIENT_ID', '');      // GitHub    → github.com/settings/developers
define('GITHUB_CLIENT_SECRET', '');

define('GOOGLE_CLIENT_ID', '');      // console.cloud.google.com/auth/clients
define('GOOGLE_CLIENT_SECRET', '');
define('GOOGLE_BOOKS_API_KEY', '');  // Reading   → developers.google.com/books

define('STEAM_API_KEY', '');         // Gaming → steamcommunity.com/dev/apikey
define('RAWG_API_KEY', '');          // Gaming → rawg.io/apidocs

define('STRAVA_CLIENT_ID', '');      // Sports    → strava.com/settings/api
define('STRAVA_CLIENT_SECRET', '');

define('UNSPLASH_ACCESS_KEY', '');
define('UNSPLASH_SECRET_KEY', '');

define('TRACKIE_ENCRYPTION_KEY', ''); // generate a random 32-byte base64 string

// ExerciseDB via RapidAPI — exercise library for the Gym module.
define('EXERCISEDB_API_KEY',  '');
define('EXERCISEDB_API_HOST', 'exercisedb.p.rapidapi.com');
