<?php
/**
 * Trackie — environment configuration TEMPLATE.
 *
 * Copy this file to config/env.php and fill in your own values.
 * config/env.php is gitignored — never commit real credentials.
 *
 * Every key below is optional unless marked required. Anything left
 * undefined falls back to a safe default in config/app.php.
 */

// ── Application ────────────────────────────────────────────────
// 'local' or 'production'. Reserved: not yet used to change behavior.
define('APP_ENV', 'local');

// Show PHP errors on screen. Reserved: errors are still only logged
// today. Keep false in production.
define('APP_DEBUG', false);

// Canonical public base URL, no trailing slash (e.g. 'https://example.com').
// Reserved for making OAuth callback URLs config-driven. Not read yet.
define('APP_URL', '');

// ── Database (required) ────────────────────────────────────────
$__host    = $_SERVER['HTTP_HOST'] ?? '';
$__isLocal = $__host === ''                              // CLI
          || str_contains($__host, 'localhost')
          || str_starts_with($__host, '127.')
          || str_starts_with($__host, '192.168.')
          || str_starts_with($__host, '10.');

if ($__isLocal) {
    // ── Local development ────────────────────────────────────────
    define('DB_HOST', 'localhost');
    define('DB_NAME', 'trackie');
    define('DB_USER', 'root');
    define('DB_PASS', '');
} else {
    // ── Live hosting ──────────────────────────────────────────────
    define('DB_HOST', '');
    define('DB_NAME', '');
    define('DB_USER', '');
    define('DB_PASS', '');
}
unset($__host, $__isLocal);

// ── Timezone ───────────────────────────────────────────────────
// Must match the MySQL server's timezone. A constant, not putenv():
// putenv() is disabled on some shared hosts (e.g. InfinityFree).
define('APP_TIMEZONE', 'UTC');

// ── Optional integrations (leave blank to disable) ──────────────
// Each of these is read via env('KEY') from includes/functions.php.
// See includes/integrations.php for what each one unlocks and where
// to get a key.

define('SPOTIFY_CLIENT_ID',     '');
define('SPOTIFY_CLIENT_SECRET', '');

// Weather runs on Open-Meteo (open-meteo.com) — free, no key needed.

define('GEMINI_API_KEY', '');        // AI Coach  → aistudio.google.com/app/apikey
define('GITHUB_CLIENT_ID', '');      // GitHub    → github.com/settings/developers
define('GITHUB_CLIENT_SECRET', '');

define('GOOGLE_CLIENT_ID', '');      // console.cloud.google.com/auth/clients
define('GOOGLE_CLIENT_SECRET', '');
define('GOOGLE_BOOKS_API_KEY', '');  // Reading   → developers.google.com/books

define('STEAM_API_KEY', '');         // Gaming → steamcommunity.com/dev/apikey
define('RAWG_API_KEY', '');          // Gaming → rawg.io/apidocs

define('STRAVA_CLIENT_ID', '');      // Sports    → strava.com/settings/api
define('STRAVA_CLIENT_SECRET', '');

define('UNSPLASH_ACCESS_KEY', '');
define('UNSPLASH_SECRET_KEY', '');

// ── Secrets ────────────────────────────────────────────────────
define('TRACKIE_ENCRYPTION_KEY', ''); // generate a random 32-byte base64 string

// Cron: the HTTP token for cron/dispatch.php is NOT configured here. It is
// generated on the first CLI run and stored in keys/cron_token.txt.

// WorkoutDB — exercise demo videos/GIFs + instructions in the Gym workout
// screen → work-out-db.com (Dashboard → Keys). API_URL is optional; set it
// only if you point at a self-hosted/other deployment.
define('WORKOUTDB_API_KEY', '');
define('WORKOUTDB_API_URL', 'https://api.work-out-db.com');

// ExerciseDB via RapidAPI — exercise library for the Gym module.
define('EXERCISEDB_API_KEY',  '');
define('EXERCISEDB_API_HOST', 'exercisedb.p.rapidapi.com');

// ── Email (password resets) ─────────────────────────────────────
// InfinityFree and most free hosts disable PHP mail(). Configure ONE
// transport (see includes/mailer.php):
//   Brevo HTTP API (recommended, free 300/day) → app.brevo.com → SMTP & API → API keys
define('BREVO_API_KEY', '');
//   …or any SMTP server (Gmail needs an App Password, port 587 or 465):
define('SMTP_HOST', '');
define('SMTP_PORT', 587);
define('SMTP_USER', '');
define('SMTP_PASS', '');
// Sender shown on emails. With Brevo this must be a verified sender address.
define('MAIL_FROM', '');
define('MAIL_FROM_NAME', 'Trackie');
// Public contact address shown on the Privacy Policy / Terms pages.
define('SUPPORT_EMAIL', '');
